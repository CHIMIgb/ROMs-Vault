# ============================================================================
# ROMs Vault - Plantilla de variables de entorno (.env.example)
# ============================================================================
# Copia este archivo a `.env` en la raíz del proyecto y completa los valores:
#
#     cp .env.example .env
#
# `.env` NUNCA se versiona (lo ignora .gitignore); esta plantilla SÍ.
# Mantén `.env` y `.env.example` con el MISMO conjunto de variables.
# Aquí los valores sirven de documentación; los secretos van vacíos.
#
# Marca [NO USADA]: el código actual de la aplicación no lee esa variable.
#   Se conserva documentada por compatibilidad (p. ej. docker-entrypoint.sh)
#   y su valor queda vacío en esta plantilla.
# ============================================================================

# ── Base de datos (PostgreSQL / Neon) ────────────────────────────────────────
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# Modo SSL del DSN (libpq). Default en código: 'require' (obligatorio en Neon).
#   require (producción/Neon) | disable (local y tests, sin SSL) | prefer | verify-full
DB_SSLMODE=
# [NO USADA] La app fija UTF-8 con SET NAMES; no lee este valor.
DB_CHARSET=

# ── Sesión ───────────────────────────────────────────────────────────────────
# [NO USADA] La app no firma la sesión con este valor (usa JWT y CSRF propios).
# Se conserva porque docker-entrypoint.sh la escribe en el .env del contenedor.
SESSION_SECRET=

# ── JWT (autenticación del panel de administración) ──────────────────────────
# firebase/php-jwt exige un secreto de >= 32 bytes (HS256).
JWT_SECRET=
JWT_EXPIRATION=
JWT_REFRESH_THRESHOLD=

# ── Login: rate limit por IP y lockout por cuenta ────────────────────────────
# Rate limit por IP (AuthController: AUTH_LOGIN_MAX intentos por ventana).
AUTH_LOGIN_MAX=
AUTH_LOGIN_WINDOW=
# Lockout por cuenta: fallos consecutivos antes de bloquear y duración
# del bloqueo en segundos (ítem 2.2, OWASP A07).
AUTH_LOCKOUT_MAX=
AUTH_LOCKOUT_SECONDS=
# 2FA TOTP (opcional, rol admin): TTL del estado pendiente de verificación.
TFA_PENDING_TTL=
TFA_ISSUER=
# Rate limit por IP específico del segundo factor (fuerza bruta contra TOTP).
TFA_RATE_LIMIT_MAX=
TFA_RATE_LIMIT_WINDOW=

# ── Logging de autenticación ─────────────────────────────────────────────────
# Ruta absoluta del directorio de logs de seguridad.
# Vacío/ausente = sys_get_temp_dir()/rv_logs (temp del sistema).
# En Docker el entrypoint lo fija en /var/log/roms-vault.
AUTH_LOG_DIR=
# Tamaño máximo por archivo antes de rotar (bytes; default 10 MB).
LOG_MAX_BYTES=

# ── Google OAuth ─────────────────────────────────────────────────────────────
# [NO USADA] La autenticación con Google OAuth no está implementada; la app no
# lee estas variables. Se conservan porque docker-entrypoint.sh las escribe en
# el .env del contenedor.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── ROM Proxy ────────────────────────────────────────────────────────────────
# Máximo de peticiones por IP en la ventana de tiempo
RATE_LIMIT_MAX=
# Ventana de tiempo en segundos para el rate limiting
RATE_LIMIT_WINDOW=
# Vigencia de los enlaces firmados HMAC del proxy/descargas, en segundos
# (ítem 3.1). Default 900 s (15 min); reduce la ventana de replay frente a
# las 2 h originales. Se aplica al verificar (UrlSigner::ttl()), nunca se
# almacenan los enlaces.
SIGNED_URL_TTL=
# Hosts permitidos para el proxy de streaming (anti-SSRF, ítem 3.2).
# Coma-separada, sin espacios. Si en el futuro hay más hosts de entrega,
# listarlos aquí; vacío/ausente = defaults (drive.google.com,
# drive.usercontent.google.com). El proxy NUNCA sigue redirects a otros hosts.
GDRIVE_ALLOWED_HOSTS=
# Orígenes permitidos para CORS (separados por coma). Vacío = permitir todos
# Con valor, el proxy (rom_proxy.php) además valida Origin/Referer en GET/HEAD
# (anti-hotlink, ítem 3.3): rechaza peticiones con headers de un origen no
# listado; sin headers se permite (firma HMAC + TTL). Incluye el origen de dev
# si pruebas en local (p. ej. http://localhost:8000).
# Ejemplo: https://mi-dominio.com,https://roms-vault.vercel.app
ALLOWED_ORIGINS=
# Proxies de confianza para RateLimiter::clientIp() (ítem 3.2 / §12).
# Lista separada por comas de IPs sueltas o redes CIDR (IPv4/IPv6) cuyo
# REMOTE_ADDR sí puede reenviar X-Forwarded-For / X-Real-IP.
# Vacío/ausente = DENY-BY-DEFAULT: no se confía en ninguna cabecera de proxy
# y clientIp() devuelve la IP del peer TCP. En local no hace falta configurarla
# (no hay proxy). En Vercel/contenedor con proxy, definirlas como variable de
# entorno del deploy (ver docs/2026-10-10-trusted-proxies.md).
TRUSTED_PROXIES=
# Rate limit por IP de las descargas locales (HomeController::download),
# separado del de streaming para no penalizar al emulador (Range Requests).
DOWNLOAD_RATE_LIMIT_MAX=
DOWNLOAD_RATE_LIMIT_WINDOW=
# Umbral de precarga en bytes (default 128 MB).  ROMs de cores pesados
# (PS1, N64, DS, PSP…) que quepan en este tamaño se cargan en memoria
# en vez de streaming, eliminando la latencia de red.  Para desactivar
# la precarga de cores 3D, poner en 0.
PRELOAD_MAX_BYTES=

# ── Emulador (CPU/GPU del navegador) ─────────────────────────────────────────
# Headers COOP/COEP en la página del emulador SOLO para los cores que
# usan threads (ahora: N64, PSP, DOSBox). Habilitan SharedArrayBuffer →
# mejora de rendimiento en equipos multinúcleo. COEP se emite como
# 'credentialless' (bajo riesgo: no exige CORS en todos los recursos).
# Se añaden cores de uno en uno tras probar cada uno.
# 1 = activado (default), 0 = desactivado.
ENABLE_EMULATOR_THREADS=

# ── i18n ─────────────────────────────────────────────────────────────────────
# Idioma por defecto de la interfaz (ítem 6.1). Valores: es | en | fr | pt |
# de | ja | it | ru | tr | zh | ko | ar. Default 'es'. La detección dinámica
# (cookie / Accept-Language) fija el idioma activo en tiempo de ejecución.
I18N_LANG=

# ── Traducción automática de contenido (i18n bloque 2) ───────────────────────
# Proveedor de traducción del contenido de BD (categorías/juegos).
#   none   = sin traducción (seguro; el contenido se muestra en 'es')
#   deepl  = DeepL API (recomendado: Free 500k car/mes, sin servidor)
#   google = Google Cloud Translation (requiere facturación + API key)
# Las traducciones se guardan en la BD: el proveedor solo se usa AL traducir
# (crear/editar/backfill), no en producción. Ante error degrada a 'none'.
TRANSLATE_PROVIDER=
# Clave del proveedor. Con TRANSLATE_PROVIDER=deepl es la DeepL API key
# (plan Free: termina en ':fx'); con google, la API key de Cloud Translation
# (v2 Basic). SOLO servidor; nunca se commitea (solo .env local y las
# Environment Variables de Vercel/Docker).
TRANSLATE_API_KEY=
# Idiomas destino de la auto-traducción (coma-separada, códigos de I18n).
# Vacío = todos los idiomas de I18n::LANGUAGES menos 'es' (11 idiomas).
TRANSLATE_TARGETS=
# Timeout de la llamada al proveedor de traducción, en segundos.
TRANSLATE_TIMEOUT=
# Modo de traducción AL GUARDAR desde el admin:
#   async (por defecto) = el guardado encola en `traduccion_cola` y responde al
#                         instante; traduce el worker CLI
#                         (scripts/worker-traducciones.php) con reintentos y
#                         backoff. Requiere la migración
#                         data/migrations/2026-10-14-traduccion-cola.sql y un
#                         worker que drene la cola: proceso persistente o cron
#                         (php scripts/worker-traducciones.php --una-vez).
#                         SIN worker, el contenido guardado se queda en 'es'
#                         hasta que el worker se ejecute.
#   sync                = se traduce dentro de la misma petición (antes del
#                         redirect). No necesita worker. Útil donde no haya
#                         proceso persistente (p. ej. hosting serverless).
#
# En modo async, además del worker/cron, el admin dispara un «drenado
# oportunista» tras guardar: responde el redirect al instante y lanza una
# SEGUNDA petición interna (endpoints/drain_traducciones.php, fire-and-forget)
# que procesa unos pocos trabajos de la cola. Así las traducciones aparecen en
# segundos aunque el cron (GitHub Actions) se dispare tarde, y el formulario no
# espera. Requiere INTERNAL_DRAIN_SECRET (ver abajo); sin él, se omite el
# drenado. Se ajusta con:
TRANSLATE_MODE=
# Máximo de trabajos de la cola a drenar tras cada guardado en el admin (async).
# 0 = sin límite (no recomendado en peticiones web). Default: 3.
TRANSLATE_OPORTUNISTA_MAX=
# Presupuesto de tiempo del drenado oportunista, en segundos. Acota cuándo
# EMPEZAR un trabajo nuevo; no interrumpe el que ya está en curso.
# 0 = sin límite (no recomendado). Default: 5.
TRANSLATE_OPORTUNISTA_PRESUPUESTO=
# Secreto compartido del endpoint interno de drenado. El admin lo envía en la
# cabecera X-Internal-Drain; endpoints/drain_traducciones.php lo compara en
# tiempo constante. Si está vacío, el drenado oportunista se omite (cae al
# cron/worker). Generar con:
#   php -r "echo bin2hex(random_bytes(32));"
INTERNAL_DRAIN_SECRET=
# [OPCIONAL] URL interna del endpoint de drenado. Normalmente se deriva del
# puerto local (SERVER_PORT) y no hace falta definirla; úsala solo si el puerto
# no es fiable en tu despliegue.
INTERNAL_DRAIN_URL=

# ── Almacenamiento de imágenes (Cloudflare R2) ───────────────────────────────
# Con el bloque completo definido, las portadas/capturas se suben a R2 y se
# sirven como URL pública (se añade el host a la CSP img-src). Vacío/ausente =
# modo local (public/uploads/), usado en dev y tests. El endpoint y los
# secretos NUNCA se commitean (solo en .env local y Vercel Environment Variables).
# [NO USADA] La app usa R2_ENDPOINT (no el account id). Se conserva porque
# docker-entrypoint.sh la escribe en el .env del contenedor.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_ACCESS_KEY_SECRET=
# Endpoint S3-compatible: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=
# URL pública base que se guarda en BD y host que se añade a la CSP.
# Ej. r2.dev: R2_PUBLIC_BASE=https://pub-<hash>.r2.dev  R2_PUBLIC_HOST=pub-<hash>.r2.dev
# Ej. dominio propio: R2_PUBLIC_BASE=https://img.dominio.com  R2_PUBLIC_HOST=img.dominio.com
R2_PUBLIC_BASE=
R2_PUBLIC_HOST=
# Región SigV4 del cliente S3. Para R2 se usa 'auto' (default del código).
R2_REGION=
