FROM php:8.2-cli

# Instalar dependencias del sistema y extensiones PHP necesarias (PostgreSQL)
RUN apt-get update && apt-get install -y \
    libpq-dev \
    unzip \
    && docker-php-ext-install pdo pdo_pgsql pgsql \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Instalar Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Configurar el directorio de trabajo
WORKDIR /var/task

# Copiar archivos del proyecto
COPY . .

# Instalar dependencias de PHP
RUN composer install --no-dev --optimize-autoloader

# Crear la carpeta de uploads y darle permisos (temporal, en Vercel el filesystem es efímero)
RUN mkdir -p public/uploads && chmod -R 777 public/uploads

# Iniciar el servidor integrado de PHP apuntando al puerto que Vercel asigna dinámicamente ($PORT)
CMD php -S 0.0.0.0:$PORT index.php
