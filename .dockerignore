# Contexto minimizado para docker build (ítem 9.3)
# El Dockerfile hace COPY . .; estos archivos NO entran en la imagen.
# Los tests/docs/backups siguen en git, pero no se distribuyen.

.git
.agents
.opencode
.vercel
scripts
.gitignore
.gitattributes
.editorconfig
.dockerignore
.phpunit.cache
.phpunit.result.cache

.env
.env.*
# Credenciales de la cuenta de servicio de Google: nunca entran en la imagen.
# (En producción la clave viaja en GOOGLE_SERVICE_ACCOUNT_JSON_B64.)
.secrets/

tests/
scratch/
docs/
data/backup registros DB/
vendor/

*.log
generate_imports.py