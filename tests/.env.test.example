# Plantilla de secretos para la suite de tests.
# Copia este fichero a tests/.env.test y rellena los valores de tu entorno local.
# tests/.env.test está en .gitignore: NUNCA se versiona.
#
#   cp tests/.env.test.example tests/.env.test
#
# Ni este fichero ni el repo deben contener credenciales reales de producción.

# Contraseña del PostgreSQL local de prueba (usuario del sistema).
TEST_DB_PASSWORD=<password-del-postgres-local>

# Contraseña del usuario admin/admin_tfa de la BD de test (roms-vault-test).
TEST_ADMIN_PASSWORD=<password-del-admin-de-la-bd-de-test>

# Secreto TOTP (base32) del usuario admin_tfa de test.
TEST_TFA_SECRET=<secreto-base32-totp-de-prueba>

# Secreto HS256 falso del servidor de integración (>= 32 bytes).
TEST_JWT_SECRET=<secreto-hs256-de-prueba-de-al-menos-32-bytes>
