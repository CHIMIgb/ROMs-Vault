# ROMs Vault — Defensa en profundidad para public/bios/
# Los archivos BIOS son binarios que el emulador lee directamente desde el
# navegador (se sirven como application/octet-stream). Este archivo impide
# que scripts subidos por error puedan ejecutarse.

# ── Bloquear ejecución de scripts (Apache 2.4: Require, no Order/Deny) ────────
<FilesMatch "\.(?i:php|phtml|php3|php4|php5|php7|php8|phar|cgi|pl|py|sh|asp|aspx|jsp)$">
    Require all denied
</FilesMatch>

# ── Bloquear acceso a archivos sensibles / ocultos ───────────────────────────
<FilesMatch "^\.(htaccess|htpasswd|env|log|sql|git)" >
    Require all denied
</FilesMatch>

# ── Sin listado de directorios ───────────────────────────────────────────────
Options -Indexes
