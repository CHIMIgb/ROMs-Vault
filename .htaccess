Options -Indexes
RewriteEngine On

# ── Excluir rom_proxy.php del rewrite (es un archivo real) ──────────────────
RewriteCond %{REQUEST_URI} !^/rom_proxy\.php

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

# ── Cabeceras de seguridad globales ──────────────────────────────────────────
<IfModule mod_headers.c>
    # Necesarias para SharedArrayBuffer (PSP, N64 en EmulatorJS con threads)
    # Solo se aplican a la página play y al proxy
    <FilesMatch "^(index\.php|rom_proxy\.php)$">
        Header set Cross-Origin-Opener-Policy "same-origin"
        Header set Cross-Origin-Embedder-Policy "require-corp"
    </FilesMatch>

    # CORS para el proxy (permite que el JS del navegador acceda a la ROM)
    <Files "rom_proxy.php">
        Header set Access-Control-Allow-Origin "*"
        Header set Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
        Header set Access-Control-Allow-Headers "Range, Content-Type"
        Header set Access-Control-Expose-Headers "Content-Length, Content-Range, Accept-Ranges"
        Header set Timing-Allow-Origin "*"
    </Files>
</IfModule>

# ── Comprimir JS/CSS pero NO archivos de ROM (evita doble compresión) ────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript
    SetEnvIfNoCase Request_URI rom_proxy\.php no-gzip dont-vary
</IfModule>
