# ROMs Vault — Apache configuration

# ── Enrutamiento principal ──────────────────────────────────────────────────
# Redirigir todo al index.php excepto archivos y directorios reales
RewriteEngine On

# ── Entrypoints externos (reubicados en /endpoints) ─────────────────────────
# Las URLs públicas /rom_proxy.php y /ajax_*.php se mantienen idénticas.
RewriteRule ^rom_proxy\.php$   endpoints/rom_proxy.php [L,QSA]
RewriteRule ^ajax_[a-z]+\.php$ endpoints/$0            [L,QSA]

# ── Código de la aplicación ─────────────────────────────────────────────────
# El código bajo /src nunca debe servirse por HTTP.
RewriteRule ^src/ - [F,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?_url=/$1 [QSA,L]

# ── Errores personalizados ──────────────────────────────────────────────────
ErrorDocument 404 /index.php?controller=errors&action=notFound
ErrorDocument 403 /index.php?controller=errors&action=forbidden
ErrorDocument 500 /index.php?controller=errors&action=serverError

# ── Seguridad básica ────────────────────────────────────────────────────────
# Bloquear acceso directo a archivos sensibles
# (Apache 2.4: usar Require, no Order/Deny)
<FilesMatch "\.(env|log|sql|sh|bak)$">
    Require all denied
</FilesMatch>

# Bloquear listado de directorios
Options -Indexes

# Ocultar versión de PHP
<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>

# ── Caché para assets estáticos ─────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css              "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType image/png             "access plus 1 month"
    ExpiresByType image/jpeg            "access plus 1 month"
    ExpiresByType image/webp            "access plus 1 month"
    ExpiresByType image/gif             "access plus 1 month"
</IfModule>
