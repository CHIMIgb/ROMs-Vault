# ROMs Vault — Apache configuration

# ── Enrutamiento principal ──────────────────────────────────────────────────
# Redirigir todo al index.php excepto archivos y directorios reales
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?_url=/$1 [QSA,L]

# ── Errores personalizados ──────────────────────────────────────────────────
ErrorDocument 404 /index.php?controller=errors&action=notFound
ErrorDocument 403 /index.php?controller=errors&action=forbidden
ErrorDocument 500 /index.php?controller=errors&action=serverError

# ── Seguridad básica ────────────────────────────────────────────────────────
# Bloquear acceso directo a archivos sensibles
<FilesMatch "\.(env|log|sql|sh|bak)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Bloquear listado de directorios
Options -Indexes

# Ocultar versión de PHP
<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>

# ── Caché para assets estáticos ─────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css              "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType image/png             "access plus 1 month"
    ExpiresByType image/jpeg            "access plus 1 month"
    ExpiresByType image/webp            "access plus 1 month"
    ExpiresByType image/gif             "access plus 1 month"
</IfModule>
